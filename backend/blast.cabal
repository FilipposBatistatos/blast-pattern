cabal-version:      3.0
name:               blast-sim
version:            0.1.0.0
build-type:         Simple

common shared
  default-language: Haskell2010
  ghc-options:      -Wall
  build-depends:    base >=4.14 && <5

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:  Blast.Pattern
                    Blast.Simulate
                    Blast.Render.Svg

executable blast
  import:           shared
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    blast-sim, optparse-applicative
